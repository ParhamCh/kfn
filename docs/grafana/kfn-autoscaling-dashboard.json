{
  "title": "kfn — autoscaling signals",
  "tags": ["kfn", "autoscaling"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "function",
        "label": "Function",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "definition": "label_values(kfn_in_flight_requests, function)",
        "query": { "query": "label_values(kfn_in_flight_requests, function)", "refId": "fn" },
        "refresh": 2,
        "includeAll": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests / sec",
      "description": "The primary signal: rate(kfn_requests_total[30s]) summed over replicas. Counter-based, so it never drops a request, fast or slow. It is a per-second average over the 30s window — one isolated request reads 1/30 ≈ 0.03, not 1; sustain N/sec to read N.",
      "type": "stat",
      "interval": "10s",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value" },
      "targets": [ { "refId": "A", "expr": "kfn:function:request_rate_30s{function=\"$function\"}" } ]
    },
    {
      "id": 14,
      "title": "Total requests (all-time)",
      "description": "Exact cumulative count of requests this function has served — the raw kfn_requests_total counter, summed across pods. Goes up by exactly what you send and holds steady (no window, no estimate, no wobble). Caveat: a pod restart resets its counter to 0, so the sum drops when pods recycle.",
      "type": "stat",
      "interval": "10s",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value" },
      "targets": [ { "refId": "A", "expr": "sum(kfn_requests_total{function=\"$function\"})", "instant": true } ]
    },
    {
      "id": 2,
      "title": "p95 latency",
      "type": "stat",
      "interval": "10s",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "kfn:function:latency_p95{function=\"$function\"}" } ]
    },
    {
      "id": 3,
      "title": "CPU utilization (vs limit)",
      "type": "stat",
      "interval": "10s",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.85 } ] }
        }, "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "kfn:function:cpu_utilization{function=\"$function\"}" } ]
    },
    {
      "id": 4,
      "title": "Replicas",
      "type": "stat",
      "interval": "10s",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "kfn:function:replicas{function=\"$function\"}" } ]
    },
    {
      "id": 13,
      "title": "Data freshness (up)",
      "description": "Is Prometheus scraping this function right now? LIVE (1) = green, DOWN (0/absent) = red. The trust backbone — every other panel is only as good as this. From `up` joined to the function via kfn:pod:function.",
      "type": "stat",
      "interval": "10s",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0,
        "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "LIVE", "color": "green", "index": 1 } } } ],
        "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
      }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value" },
      "targets": [ { "refId": "A", "expr": "kfn:function:up{function=\"$function\"}" } ]
    },
    {
      "id": 5,
      "title": "Requests/sec per replica",
      "description": "RPS per pod (kfn_requests_total carries a pod label), plus the bold 'total' line — the same kfn:function:request_rate_30s series as the Requests/sec stat, so they always agree.",
      "type": "timeseries",
      "interval": "10s",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [
        { "matcher": { "id": "byName", "options": "total" }, "properties": [ { "id": "custom.lineWidth", "value": 2 }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] }
      ] },
      "targets": [
        { "refId": "A", "expr": "kfn:function:request_rate_30s{function=\"$function\"}", "legendFormat": "total" },
        { "refId": "B", "expr": "sum by (pod) (rate(kfn_requests_total{function=\"$function\"}[30s]))", "legendFormat": "{{pod}}" }
      ]
    },
    {
      "id": 6,
      "title": "Request rate by status class",
      "description": "RPS grouped by HTTP status class (2xx success / 4xx client + shed / 5xx server). No total line — that's on the per-replica chart to the left.",
      "type": "timeseries",
      "interval": "10s",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [
        { "matcher": { "id": "byName", "options": "2xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
        { "matcher": { "id": "byName", "options": "4xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
        { "matcher": { "id": "byName", "options": "5xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
      ] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(kfn_requests_total{function=\"$function\", code=~\"2..\"}[30s]))", "legendFormat": "2xx" },
        { "refId": "B", "expr": "sum(rate(kfn_requests_total{function=\"$function\", code=~\"4..\"}[30s]))", "legendFormat": "4xx" },
        { "refId": "C", "expr": "sum(rate(kfn_requests_total{function=\"$function\", code=~\"5..\"}[30s]))", "legendFormat": "5xx" }
      ]
    },
    {
      "id": 7,
      "title": "CPU — cores vs limit",
      "type": "timeseries",
      "interval": "10s",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 3, "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "kfn:function:cpu_cores{function=\"$function\"}", "legendFormat": "cores used" },
        { "refId": "B", "expr": "kfn:function:cpu_limit_cores{function=\"$function\"}", "legendFormat": "limit" },
        { "refId": "C", "expr": "kfn:function:cpu_throttle_ratio{function=\"$function\"}", "legendFormat": "throttle ratio" }
      ]
    },
    {
      "id": 8,
      "title": "Latency p95 / p99",
      "type": "timeseries",
      "interval": "10s",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "kfn:function:latency_p95{function=\"$function\"}", "legendFormat": "p95" },
        { "refId": "B", "expr": "kfn:function:latency_p99{function=\"$function\"}", "legendFormat": "p99" }
      ]
    },
    {
      "id": 9,
      "title": "Memory utilization (vs limit)",
      "type": "timeseries",
      "interval": "10s",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "kfn:function:memory_utilization{function=\"$function\"}", "legendFormat": "memory / limit" } ]
    },
    {
      "id": 10,
      "title": "Errors & shedding",
      "type": "timeseries",
      "interval": "10s",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [
        { "matcher": { "id": "byName", "options": "5xx ratio" }, "properties": [ { "id": "unit", "value": "percentunit" } ] },
        { "matcher": { "id": "byName", "options": "shed 429/s" }, "properties": [ { "id": "unit", "value": "reqps" } ] }
      ] },
      "targets": [
        { "refId": "A", "expr": "kfn:function:error_ratio{function=\"$function\"}", "legendFormat": "5xx ratio" },
        { "refId": "B", "expr": "kfn:function:shed_rate{function=\"$function\"}", "legendFormat": "shed 429/s" }
      ]
    },
    {
      "id": 11,
      "title": "Concurrency saturation — long-lived requests only",
      "description": "Gauge-based (in-flight / capacity). Meaningful for blocking workloads like sleep; for fast requests the in-flight gauge reads ~0 between scrapes, so use Requests/sec instead. Only appears for functions with MAX_CONCURRENCY set.",
      "type": "timeseries",
      "interval": "10s",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 30, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "kfn:function:concurrency_saturation{function=\"$function\"}", "legendFormat": "saturation" } ]
    },
    {
      "id": 12,
      "title": "Build info",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 12, "y": 30, "w": 12, "h": 7 },
      "options": { "showHeader": true },
      "targets": [ { "refId": "A", "expr": "kfn_build_info{function=\"$function\"}", "format": "table", "instant": true } ]
    }
  ]
}
