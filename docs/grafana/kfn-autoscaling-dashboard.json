{
  "title": "kfn — autoscaling signals",
  "tags": ["kfn", "autoscaling"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "function",
        "label": "Function",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "definition": "label_values(kfn_in_flight_requests, function)",
        "query": { "query": "label_values(kfn_in_flight_requests, function)", "refId": "fn" },
        "refresh": 2,
        "includeAll": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Concurrency saturation",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.85 } ] }
        }, "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "kfn:function:concurrency_saturation{function=\"$function\"}" } ]
    },
    {
      "id": 2,
      "title": "CPU utilization (vs limit)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.85 } ] }
        }, "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "kfn:function:cpu_utilization{function=\"$function\"}" } ]
    },
    {
      "id": 3,
      "title": "Replicas",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "kfn:function:replicas{function=\"$function\"}" } ]
    },
    {
      "id": 4,
      "title": "p95 latency",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "kfn:function:latency_p95{function=\"$function\"}" } ]
    },
    {
      "id": 5,
      "title": "Concurrency — in-flight vs capacity",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "kfn:function:inflight{function=\"$function\"}", "legendFormat": "in-flight" },
        { "refId": "B", "expr": "kfn:function:capacity{function=\"$function\"}", "legendFormat": "capacity (MAX_CONCURRENCY x replicas)" }
      ]
    },
    {
      "id": 6,
      "title": "CPU — cores vs limit",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 3, "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "kfn:function:cpu_cores{function=\"$function\"}", "legendFormat": "cores used" },
        { "refId": "B", "expr": "kfn:function:cpu_limit_cores{function=\"$function\"}", "legendFormat": "limit" }
      ]
    },
    {
      "id": 7,
      "title": "Request rate & shed (429) rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "kfn:function:request_rate{function=\"$function\"}", "legendFormat": "requests/s" },
        { "refId": "B", "expr": "kfn:function:shed_rate{function=\"$function\"}", "legendFormat": "shed 429/s" }
      ]
    },
    {
      "id": 8,
      "title": "CPU utilization & throttle ratio",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "kfn:function:cpu_utilization{function=\"$function\"}", "legendFormat": "utilization" },
        { "refId": "B", "expr": "kfn:function:cpu_throttle_ratio{function=\"$function\"}", "legendFormat": "throttle ratio" }
      ]
    },
    {
      "id": 9,
      "title": "Latency p95 / p99",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "kfn:function:latency_p95{function=\"$function\"}", "legendFormat": "p95" },
        { "refId": "B", "expr": "kfn:function:latency_p99{function=\"$function\"}", "legendFormat": "p99" }
      ]
    },
    {
      "id": 10,
      "title": "Memory utilization (vs limit)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "kfn:function:memory_utilization{function=\"$function\"}", "legendFormat": "memory / limit" }
      ]
    },
    {
      "id": 11,
      "title": "Error ratio & panics",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 29, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "kfn:function:error_ratio{function=\"$function\"}", "legendFormat": "5xx ratio" },
        { "refId": "B", "expr": "sum(rate(kfn_panics_total{function=\"$function\"}[5m]))", "legendFormat": "panics/s" }
      ]
    },
    {
      "id": 12,
      "title": "Build info",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 12, "y": 29, "w": 12, "h": 7 },
      "options": { "showHeader": true },
      "targets": [
        { "refId": "A", "expr": "kfn_build_info{function=\"$function\"}", "format": "table", "instant": true }
      ]
    }
  ]
}
