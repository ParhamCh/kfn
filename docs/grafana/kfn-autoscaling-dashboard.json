{
  "title": "kfn — autoscaling signals",
  "tags": ["kfn", "autoscaling"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "function",
        "label": "Function",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "definition": "label_values(kfn_in_flight_requests, function)",
        "query": { "query": "label_values(kfn_in_flight_requests, function)", "refId": "fn" },
        "refresh": 2,
        "includeAll": false,
        "current": {}
      },
      {
        "name": "rate_window",
        "label": "Rate window",
        "type": "custom",
        "query": "30s,1m,2m,5m",
        "current": { "text": "1m", "value": "1m" },
        "options": [
          { "text": "30s", "value": "30s", "selected": false },
          { "text": "1m", "value": "1m", "selected": true },
          { "text": "2m", "value": "2m", "selected": false },
          { "text": "5m", "value": "5m", "selected": false }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests / sec",
      "description": "The primary signal. RPS = rate(kfn_requests_total[$rate_window]) — a per-second average over the window (counters never drop a request, fast or slow). One isolated request reads 1/window, not 1.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 0, "w": 9, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value" },
      "targets": [ { "refId": "A", "expr": "sum(rate(kfn_requests_total{function=\"$function\"}[$rate_window]))" } ]
    },
    {
      "id": 2,
      "title": "p95 latency",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 9, "y": 0, "w": 5, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "kfn:function:latency_p95{function=\"$function\"}" } ]
    },
    {
      "id": 3,
      "title": "CPU utilization (vs limit)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 14, "y": 0, "w": 5, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.85 } ] }
        }, "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "kfn:function:cpu_utilization{function=\"$function\"}" } ]
    },
    {
      "id": 4,
      "title": "Replicas",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 19, "y": 0, "w": 5, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "kfn:function:replicas{function=\"$function\"}" } ]
    },
    {
      "id": 5,
      "title": "Request rate by status code",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (code) (rate(kfn_requests_total{function=\"$function\"}[$rate_window]))", "legendFormat": "{{code}}" } ]
    },
    {
      "id": 6,
      "title": "Request rate — 30s (fast) vs 1m (smoothed)",
      "description": "How the window trades responsiveness for noise. The autoscaler can read kfn:function:request_rate (1m) or kfn:function:request_rate_30s (30s).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "kfn:function:request_rate_30s{function=\"$function\"}", "legendFormat": "30s (fast)" },
        { "refId": "B", "expr": "kfn:function:request_rate{function=\"$function\"}", "legendFormat": "1m (smoothed)" }
      ]
    },
    {
      "id": 7,
      "title": "CPU — cores vs limit",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 3, "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "kfn:function:cpu_cores{function=\"$function\"}", "legendFormat": "cores used" },
        { "refId": "B", "expr": "kfn:function:cpu_limit_cores{function=\"$function\"}", "legendFormat": "limit" },
        { "refId": "C", "expr": "kfn:function:cpu_throttle_ratio{function=\"$function\"}", "legendFormat": "throttle ratio" }
      ]
    },
    {
      "id": 8,
      "title": "Latency p95 / p99",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "kfn:function:latency_p95{function=\"$function\"}", "legendFormat": "p95" },
        { "refId": "B", "expr": "kfn:function:latency_p99{function=\"$function\"}", "legendFormat": "p99" }
      ]
    },
    {
      "id": 9,
      "title": "Memory utilization (vs limit)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "kfn:function:memory_utilization{function=\"$function\"}", "legendFormat": "memory / limit" } ]
    },
    {
      "id": 10,
      "title": "Errors & shedding",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [
        { "matcher": { "id": "byName", "options": "5xx ratio" }, "properties": [ { "id": "unit", "value": "percentunit" } ] },
        { "matcher": { "id": "byName", "options": "shed 429/s" }, "properties": [ { "id": "unit", "value": "reqps" } ] }
      ] },
      "targets": [
        { "refId": "A", "expr": "kfn:function:error_ratio{function=\"$function\"}", "legendFormat": "5xx ratio" },
        { "refId": "B", "expr": "kfn:function:shed_rate{function=\"$function\"}", "legendFormat": "shed 429/s" }
      ]
    },
    {
      "id": 11,
      "title": "Concurrency saturation — long-lived requests only",
      "description": "Gauge-based (in-flight / capacity). Meaningful for blocking workloads like sleep; for fast requests the in-flight gauge reads ~0 between scrapes, so use Requests/sec instead. Only appears for functions with MAX_CONCURRENCY set.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 30, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "kfn:function:concurrency_saturation{function=\"$function\"}", "legendFormat": "saturation" } ]
    },
    {
      "id": 12,
      "title": "Build info",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 12, "y": 30, "w": 12, "h": 7 },
      "options": { "showHeader": true },
      "targets": [ { "refId": "A", "expr": "kfn_build_info{function=\"$function\"}", "format": "table", "instant": true } ]
    }
  ]
}
